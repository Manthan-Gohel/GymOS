# GymOS backend environment — copy to .env and fill in.
# Never commit the real .env.

# --- Required in production/staging (server refuses to start without them) ---
APP_ENV=development
# Must be a unique value, >= 32 chars, in production/staging:
SECRET_KEY=change-me
# Unique >= 32 chars; HMAC-SHA256 secret the openWA service uses to sign webhooks:
OPENWA_WEBHOOK_SECRET=
COOKIE_SECURE=true
POSTGRES_PASSWORD=

# --- Database / Redis (compose wires these automatically) ---
DATABASE_URL=sqlite:///./gymos.db
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated browser origins allowed to call the API) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Local LLM (Ollama) ---
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434/v1
# No API key needed for Ollama. Set LLM_API_KEY only for hosted providers.
LLM_API_KEY=

# --- Messaging (openWA) / Payments (YouPI-PG) ---
MESSAGING_PROVIDER=mock
OPENWA_BASE_URL=http://localhost:8080
OPENWA_API_KEY=
PAYMENTS_PROVIDER=mock
YOUPI_BASE_URL=http://localhost:3000
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=
