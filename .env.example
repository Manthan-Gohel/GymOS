# App
APP_NAME=GymOS
APP_ENV=development
SECRET_KEY=change-me-in-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_DB=gymos
POSTGRES_USER=gymos
POSTGRES_PASSWORD=gymos
DATABASE_URL=postgresql+psycopg://gymos:gymos@db:5432/gymos

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Providers toggles ('mock' | 'openwa' | 'youpi' | 'openai')
MESSAGING_PROVIDER=mock
PAYMENTS_PROVIDER=mock
LLM_PROVIDER=mock
LLM_ENABLED=false

# openWA WhatsApp integration (BLK-001)
OPENWA_BASE_URL=http://localhost:8080
OPENWA_API_KEY=
OPENWA_SESSION_ID=default
OPENWA_WEBHOOK_SECRET=

# YouPI-PG payments integration (BLK-002)
YOUPI_BASE_URL=http://localhost:3000
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=

# Real LLM API configuration (BLK-004)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
