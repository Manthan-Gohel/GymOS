# App
APP_NAME=GymOS
APP_ENV=development
SECRET_KEY=change-me-in-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_DB=gymos
POSTGRES_USER=gymos
POSTGRES_PASSWORD=gymos
DATABASE_URL=postgresql+psycopg://gymos:gymos@db:5432/gymos

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Providers (mock by default in dev/tests)
MESSAGING_PROVIDER=mock
PAYMENTS_PROVIDER=mock
LLM_PROVIDER=mock
LLM_ENABLED=false

# openWA WhatsApp integration target (real requires session/service; see BLOCKERS.md BLK-001, ADR 0001)
OPENWA_BASE_URL=http://localhost:8080
OPENWA_API_KEY=
OPENWA_SESSION_ID=default
OPENWA_WEBHOOK_SECRET=

# YouPI-PG payments integration target (real requires deployment/setup; see BLOCKERS.md BLK-002, ADR 0002)
YOUPI_BASE_URL=
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=
