# App
APP_NAME=GymOS
APP_ENV=development
SECRET_KEY=change-me-in-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_DB=gymos
POSTGRES_USER=gymos
POSTGRES_PASSWORD=gymos
DATABASE_URL=postgresql+psycopg://gymos:gymos@db:5432/gymos

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Providers (mock by default in dev/tests)
MESSAGING_PROVIDER=mock
PAYMENTS_PROVIDER=mock
LLM_PROVIDER=mock
LLM_ENABLED=false

# WhatsApp (real integration needs credentials; see BLOCKERS.md BLK-001)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Razorpay (real integration needs credentials; see BLOCKERS.md BLK-002)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
